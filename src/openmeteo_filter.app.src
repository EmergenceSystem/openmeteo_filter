{application, openmeteo_filter, [
    {description, "em_filter agent for Open-Meteo weather forecasts"},
    {vsn, "0.1.0"},
    {registered, [openmeteo_filter_sup, openmeteo_filter_server]},
    {mod, {openmeteo_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        ssl,
        inets,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        openmeteo_filter_sup,
        openmeteo_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/openmeteo_filter"}]}
]}.
